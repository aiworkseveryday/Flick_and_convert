{
  "name": "flick",
  "version": "0.2.0",
  "description": "Convert files with a flick: Shift + drag a file to open the convert wheel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "author": "Flick",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@neslinesli93/qpdf-wasm": "^0.3.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "7zip-bin": "^5.2.0",
    "ffmpeg-static": "^5.3.0",
    "heic-convert": "^2.1.0",
    "libraw-wasm": "^1.6.0",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-node": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Flick",
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "app.flick.converter",
    "productName": "Flick",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "main.js",
      "*-preload.js",
      "src/**",
      "renderer/**",
      "assets/**",
      "models/*.onnx",
      "package.json",
      "!test/**",
      "!**/*.md",
      "!node_modules/7zip-bin/{mac,linux}/**",
      "!node_modules/pdfjs-dist/{legacy,types,image_decoders}/**",
      "!node_modules/**/*.map",
      "!node_modules/7zip-bin/win/{ia32,arm64}/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/onnxruntime-node/bin/napi-v*/{darwin,linux}/**",
      "!node_modules/@tesseract.js-data/eng/4.0.0/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png",
      "artifactName": "Flick-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flick",
      "runAfterFinish": true
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}
